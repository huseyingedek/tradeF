# Kopyalayın:  cp .env.example .env

# false → gerçek backend (tradenest-api) kullanılır (varsayılan)
# true  → tarayıcı içindeki mock backend (backend olmadan arayüz denemek için)
VITE_USE_MOCK=false

# Gerçek backend adresleri (VITE_USE_MOCK=false iken)
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws

# İstek zaman aşımı (ms)
VITE_API_TIMEOUT=15000
